@page "/vendas"
@inject MercadinhoService mercadinhoService


<PageTitle>Caixa e Vendas</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Caixa e Histórico de Vendas</MudText>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <MudAlert Severity="Severity.Error" 
              Variant="Variant.Filled" 
              Closeable="true" 
              CloseIconClicked="() => mensagemErro = null" 
              Class="mb-4">
        @mensagemErro
    </MudAlert>
}

<MudGrid Spacing="3">
    <!-- Formulário do Caixa (Nova Venda) -->
    <MudItem xs="12" md="5">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Registrar Nova Venda</MudText>

            <MudSelect T="int" 
                       Label="Selecione o Produto" 
                       @bind-Value="produtoSelecionadoId" 
                       Variant="Variant.Outlined" 
                       Margin="Margin.Dense" 
                       Class="mb-3">
                <MudSelectItem Value="0">-- Selecione um produto --</MudSelectItem>
                @foreach (var prod in produtosDisponiveis)
                {
                    <MudSelectItem Value="@prod.Id">
                        @prod.Nome - (@prod.Preco.ToString("C")) [Estoque: @prod.QuantidadeEmEstoque]
                    </MudSelectItem>
                }
            </MudSelect>

            <MudNumericField T="int" 
                             Label="Quantidade" 
                             @bind-Value="quantidadeItem" 
                             Min="1" 
                             Variant="Variant.Outlined" 
                             Margin="Margin.Dense" 
                             Class="mb-3" />

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Secondary" 
                       FullWidth="true" 
                       OnClick="AdicionarAoCarrinho" 
                       Class="mb-4">
                Adicionar ao Carrinho
            </MudButton>

            <MudText Typo="Typo.subtitle1" TypoClass="fw-bold" Class="mb-2">Itens do Carrinho</MudText>

            @if (!carrinho.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Carrinho vazio.</MudText>
            }
            else
            {
                <MudList T="string" Dense="true" Class="mb-3">
                    @foreach (var item in carrinho)
                    {
                        var prod = produtosDisponiveis.FirstOrDefault(p => p.Id == item.produtoId);
                        <MudListItem T="string">
                            <div class="d-flex justify-content-between align-items-center w-100">
                                <span>@prod?.Nome (@item.quantidade x @prod?.Preco.ToString("C"))</span>
                                <MudText Typo="Typo.body2" Style="font-weight: bold;">
                                    @((prod?.Preco * item.quantidade)?.ToString("C"))
                                </MudText>
                            </div>
                        </MudListItem>
                        <MudDivider />
                    }
                </MudList>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">Total:</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success" Style="font-weight: bold;">
                        @CalcularTotalCarrinho().ToString("C")
                    </MudText>
                </div>

                <MudButton Variant="Variant.Filled" 
                           Color="Color.Success" 
                           FullWidth="true" 
                           OnClick="FinalizarVendaAsync" 
                           Size="Size.Large">
                    Finalizar Venda
                </MudButton>
            }
        </MudPaper>
    </MudItem>

    <!-- Tabela de Histórico de Vendas -->
    <MudItem xs="12" md="7">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Histórico de Vendas</MudText>

            @if (!historicoVendas.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhuma venda realizada até o momento.</MudText>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="false">
                    @foreach (var venda in historicoVendas.OrderByDescending(v => v.Id))
                    {
                        <MudExpansionPanel Text="@($"Venda #{venda.Id} - {venda.DataVenda:dd/MM/yyyy HH:mm} - Total: {venda.ValorTotal.ToString("C")}")">
                            <MudTable Items="venda.Itens" Dense="true" Elevation="0" Hover="true">
                                <HeaderContent>
                                    <MudTh>Item</MudTh>
                                    <MudTh>Qtd</MudTh>
                                    <MudTh>Preço Un.</MudTh>
                                    <MudTh>Subtotal</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Item">@context.NomeProduto</MudTd>
                                    <MudTd DataLabel="Qtd">@context.Quantidade</MudTd>
                                    <MudTd DataLabel="Preço Un.">@context.PrecoUnitario.ToString("C")</MudTd>
                                    <MudTd DataLabel="Subtotal">@context.Subtotal.ToString("C")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<ProdutoComEstoque> produtosDisponiveis = new();
    private List<Venda> historicoVendas = new();
    private List<(int produtoId, int quantidade)> carrinho = new();

    private int produtoSelecionadoId;
    private int quantidadeItem = 1;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        produtosDisponiveis = await mercadinhoService.ObterProdutosAgrupadosAsync();
        historicoVendas = await mercadinhoService.ObterVendasAsync();
    }

    private void AdicionarAoCarrinho()
    {
        mensagemErro = null;

        if (produtoSelecionadoId <= 0)
        {
            mensagemErro = "Selecione um produto válido.";
            return;
        }

        if (quantidadeItem <= 0)
        {
            mensagemErro = "A quantidade deve ser maior que zero.";
            return;
        }

        var prod = produtosDisponiveis.FirstOrDefault(p => p.Id == produtoSelecionadoId);
        if (prod == null || prod.QuantidadeEmEstoque < quantidadeItem)
        {
            mensagemErro = "Estoque insuficiente para o produto selecionado.";
            return;
        }

        carrinho.Add((produtoSelecionadoId, quantidadeItem));
        produtoSelecionadoId = 0;
        quantidadeItem = 1;
    }

    private decimal CalcularTotalCarrinho()
    {
        decimal total = 0;
        foreach (var item in carrinho)
        {
            var prod = produtosDisponiveis.FirstOrDefault(p => p.Id == item.produtoId);
            if (prod != null)
            {
                total += prod.Preco * item.quantidade;
            }
        }
        return total;
    }

    private async Task FinalizarVendaAsync()
    {
        if (!carrinho.Any()) return;

        bool sucesso = await mercadinhoService.RegistrarVendaAsync(carrinho);
        if (sucesso)
        {
            carrinho.Clear();
            mensagemErro = null;
            await CarregarDadosAsync();
        }
        else
        {
            mensagemErro = "Não foi possível finalizar a venda. Verifique se há estoque suficiente.";
        }
    }
}

