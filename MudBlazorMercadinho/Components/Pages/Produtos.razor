@page "/produtos"
@inject MercadinhoService mercadinhoService
@rendermode InteractiveServer



<MudText Typo="Typo.h5" Class="mb-4">Cadastro e Estoque</MudText>

<!-- Formulário de Cadastro -->
<MudPaper Elevation="3" Class="pa-4 mb-6">
    <MudText Typo="Typo.h6" Class="mb-3">Novo Produto</MudText>
    <MudGrid Spacing="2" AlignItems="Size.Center">
        <MudItem xs="12" sm="6" md="2">
            <MudNumericField @bind-Value="numeroId"
                             Min="1"
                             Label="ID"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="5">
            <MudTextField @bind-Value="novoProduto.Nome"
                          Label="Nome"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudNumericField @bind-Value="novoProduto.Preco"
                             Label="Preço"
                             Format="C2"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Color="Color.Info"
                       FullWidth="true"
                       OnClick="SalvarProdutoAsync"
                       Size="Size.Large">
                Salvar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Tabela de Exibição -->
<MudTable Items="produtos" Striped="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>ID</MudTh>
        <MudTh>Nome</MudTh>
        <MudTh>Preço</MudTh>
        <MudTh>Estoque</MudTh>
        <MudTh Style="text-align: center;">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ID">@context.Id</MudTd>
        <MudTd DataLabel="Nome">@context.Nome</MudTd>
        <MudTd DataLabel="Preço">@context.Preco.ToString("C")</MudTd>
        <MudTd DataLabel="Estoque">@context.QuantidadeEmEstoque</MudTd>
        <MudTd DataLabel="Ações" Style="text-align: center;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                
                <MudNumericField Value="ObterQuantidade(context.Id)"
                                 ValueChanged="(int val) => AtualizarQuantidade(context.Id, val)"
                                 Min="1"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Style="max-width: 80px; height: 32px;"
                                 HideSpinButtons="true" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Small"
                           OnClick="() => AdicionarEstoqueAsync(context.Id)">
                    + Estoque
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="() => ExcluirProdutoAsync(context.Id)">
                    Excluir
                </MudButton>
            </MudStack>
        </MudTd>

    </RowTemplate>
</MudTable>

@code {
    private List<ProdutoComEstoque> produtos = new();
    private Produto novoProduto = new();
    private int numeroId = 1; 
    private int quantidade = 1;
    private Dictionary<int, int> quantidadesPorProduto = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutosAsync();
    }

    private async Task CarregarProdutosAsync()
    {
        
        produtos = await mercadinhoService.ObterProdutosAgrupadosAsync();
    }

    private async Task SalvarProdutoAsync()
    {
        novoProduto.Id = numeroId;
        await mercadinhoService.AdicionarProdutoAsync(novoProduto);
        novoProduto = new();
        await CarregarProdutosAsync();
    }
    private int ObterQuantidade(int produtoId)
    {
        return quantidadesPorProduto.GetValueOrDefault(produtoId, 0);
    }

    private void AtualizarQuantidade(int produtoId, int quantidade)
    {
        quantidadesPorProduto[produtoId] = quantidade;
    }



    private async Task ExcluirProdutoAsync(int id)
    {
        await mercadinhoService.DeletarProdutoAsync(id);
        await CarregarProdutosAsync();
    }

    private async Task AdicionarEstoqueAsync(int id)
    {
        int qtdParaAdicionar = ObterQuantidade(id);     
        
        AtualizarQuantidade(id, 1);
        await mercadinhoService.AdicionarEstoqueAsync(id, qtdParaAdicionar);
        await CarregarProdutosAsync();
    }
}
